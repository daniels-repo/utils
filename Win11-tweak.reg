Windows Registry Editor Version 5.00

; -----------------------------
; FILE EXPLORER BEHAVIOR
; -----------------------------

; Compact view (smaller spacing)
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"UseCompactMode"=dword:00000001

; Expand navigation tree to current folder
"NavPaneExpandToCurrentFolder"=dword:00000001

; Show file extensions
"HideFileExt"=dword:00000000

; Show hidden files
"Hidden"=dword:00000001

; Show protected system files
"ShowSuperHidden"=dword:00000001

; Explorer start location = This PC
"LaunchTo"=dword:00000001

; Disable Explorer advertising / tips
"ShowSyncProviderNotifications"=dword:00000000


; -----------------------------
; QUICK ACCESS CLEANUP
; -----------------------------

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer]
"ShowRecent"=dword:00000000
"ShowFrequent"=dword:00000000


; -----------------------------
; TASKBAR SETTINGS
; -----------------------------

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]

; Taskbar size (2 = large)
"TaskbarSi"=dword:00000002

; Never combine taskbar buttons
"TaskbarGlomLevel"=dword:00000002


; -----------------------------
; TASKBAR SEARCH
; -----------------------------

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Search]

; Hide taskbar search box
"SearchboxTaskbarMode"=dword:00000000


; -----------------------------
; CLASSIC CONTEXT MENU (Windows 11)
; -----------------------------

[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}]
@=""

[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32]
@=""


Windows Registry Editor Version 5.00

; -----------------------------
; TASKBAR SIMPLIFICATION
; -----------------------------

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]

; Taskbar alignment: left
"TaskbarAl"=dword:00000000

; Widgets button: off
"TaskbarDa"=dword:00000000

; Task View button: off
"ShowTaskViewButton"=dword:00000000


; -----------------------------
; TASKBAR SEARCH HOVER
; -----------------------------

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Feeds\DSB]

; Do not show recent searches on hover
"OpenOnHover"=dword:00000000


; -----------------------------
; LEGACY WINDOW ANIMATION
; -----------------------------
; Note: this mainly affects minimize/maximize animation,
; not every modern Windows 11 animation.

[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]
"MinAnimate"="0"